rules_version = '2';

// 対人戦（PvP）専用のセキュリティルール。ホスト権威モデル:
// - ホスト（部屋を作った側）のブラウザだけが本物のGameシミュレーションを
//   持ち、盤面・通行料・ダイス等すべてを計算する「権威」。
// - ゲストは自分の手番の意思決定（hostRequestで来る質問への回答）だけを
//   guestResponse系フィールドに書き込める。盤面やGなど他のフィールドは
//   一切書き換えられない。
// - 各プレイヤーの手札（private/{uid}.hand）はそのuid本人しか読めない。
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理者判定: 許可リストのUIDに一致するか、admins/{uid} ドキュメント
    // （Firebaseコンソールから手動作成）が存在すれば管理者。UIDはランダムな
    // 内部識別子でログイン情報を含まないため、許可リストとしてコードに焼き込んでも
    // アカウントの安全性には影響しない。
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == 'KcKymLgEFmYbN1F4ZYcKvXvfUDo1'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ログイン済み本人だけが自分のセーブデータを読書きできる。
    // 例外として管理者は全プレイヤーを「閲覧のみ」できる（集計ダッシュボード用）。
    // M・ガチャ結果の正当性検証はFunctions導入後にサーバー側で行う。
    match /players/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // 管理者マーカー。存在するuid＝管理者。本人だけが自分の管理者状態を確認でき、
    // 書き込みはFirebaseコンソールからのみ（アプリからは不可）。
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 運営からのお知らせ（メール）。カード配布もここで行う。
    // 全ログインユーザーが閲覧でき、作成・編集・削除は管理者のみ。
    // 既読/カード受領の状態は各プレイヤーの players/{uid}.character 側で
    // 管理するため、このコレクションはグローバルな配信内容だけを保持する。
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // 対戦相手のフレンド一覧。相互登録は各端末が「自分の一覧」だけへ書く。
    match /pvpFriends/{uid}/entries/{friendUid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // オンライン判定用の短周期ハートビート。書込は本人のみ。
    // 閲覧は「本人」か「自分のフレンド一覧に入れている相手」だけに限定する。
    // ログイン済みなら誰でも読める設定にすると、コレクション全体のlistクエリが
    // 通ってしまい、全プレイヤーのuid・表示名・在席状況を列挙できてしまう
    // （そのuid一覧は招待スパムの宛先収集に直結する）。この形なら
    // 絞り込みのないlistは満たせず、1件ずつのgetだけが許可される。
    match /pvpPresence/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || exists(/databases/$(database)/documents/pvpFriends/$(request.auth.uid)/entries/$(uid)));
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'online', 'lastSeenAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ルーム招待。送信者だけが作成でき、受信者だけが受け取れる。
    // ⚠️ 送信者側のフレンド一覧（pvpFriends/{自分}）は送信者自身が自由に書けるので、
    // それだけを条件にすると「任意のuidを自分の一覧へ書き足す→誰にでも招待を送る」が
    // 成立し、フレンド限定の制限として機能しない。相手の一覧に自分が入っていること
    // （＝相互フレンド）も要求する。相手の一覧は相手本人しか書けないため、
    // 実際に対戦して相互登録された間柄でなければ招待を送れない。
    match /pvpInvites/{inviteId} {
      allow create: if request.auth != null
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/pvpFriends/$(request.auth.uid)/entries/$(request.resource.data.recipientUid))
        && exists(/databases/$(database)/documents/pvpFriends/$(request.resource.data.recipientUid)/entries/$(request.auth.uid))
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() == 3
        && request.resource.data.keys().hasOnly(['inviterUid', 'inviterName', 'recipientUid', 'roomCode', 'createdAt']);
      allow read: if request.auth != null && resource.data.recipientUid == request.auth.uid;
      // 受信者が開かないまま残り続けないよう、送信者も自分が出した招待を消せる。
      allow delete: if request.auth != null
        && (resource.data.recipientUid == request.auth.uid || resource.data.inviterUid == request.auth.uid);
      allow update: if false;
    }

    match /pvpRooms/{roomCode} {
      function signedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return signedIn() &&
          (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid || (resource.data.participantUids is list && request.auth.uid in resource.data.participantUids));
      }

      function isWaitingRoom() {
        return resource.data.status == 'waiting';
      }

      // 参加枠がまだ残っている待機部屋か。部外者に読ませてよいのは
      // 「これから入室し得る部屋」だけで、満室になった時点で締め出す。
      // status=='waiting'だけを条件にすると、3〜4人部屋が全員揃った後も
      // コードさえ知れば参加者名・uid・デッキ40枚・盤面を読めてしまう。
      function isJoinableWaitingRoom() {
        return isWaitingRoom() &&
          (!(resource.data.participants is list) ||
           !(resource.data.playerCount is int) ||
           resource.data.participants.size() < resource.data.playerCount);
      }

      function isValidJoin() {
        return signedIn() &&
          isWaitingRoom() &&
          resource.data.guestUid == null &&
          request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.status == 'active' &&
          request.resource.data.guestName is string &&
          request.resource.data.guestName.size() > 0 &&
          request.resource.data.guestName.size() <= 10 &&
          request.resource.data.guestColor is int &&
          request.resource.data.guestDeckList is list &&
          request.resource.data.guestDeckList.size() == 40 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestUid', 'guestName', 'guestColor', 'guestDeckList', 'participants', 'status']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == resource.data.participants.size() + 1;
      }

      function isValidRosterJoin() {
        return signedIn() && resource.data.status == 'waiting' &&
          request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.participants is list && resource.data.participants is list &&
          // 同じuidが既に参加者リストにいる場合の再参加（自分の枠の重複占有）を拒否する。
          !(resource.data.participantUids is list && request.auth.uid in resource.data.participantUids) &&
          request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
          request.resource.data.participants.size() <= request.resource.data.playerCount &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantUids', 'guestUid', 'guestName', 'guestColor', 'guestDeckList']) &&
          request.resource.data.participants[resource.data.participants.size()].uid == request.auth.uid &&
          request.resource.data.participants[resource.data.participants.size()].name is string &&
          request.resource.data.participants[resource.data.participants.size()].name.size() > 0 &&
          request.resource.data.participants[resource.data.participants.size()].name.size() <= 10 &&
          request.resource.data.participants[resource.data.participants.size()].deckList is list &&
          request.resource.data.participants[resource.data.participants.size()].deckList.size() == 40;
      }

      function isValidGuestResponse() {
        return resource.data.guestUid == request.auth.uid &&
          request.resource.data.guestResponseId is int &&
          request.resource.data.guestResponseId == resource.data.hostRequestId &&
          request.resource.data.guestResponseId > resource.data.guestResponseId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestResponse', 'guestResponseId']);
      }

      function isValidGuestAction() {
        return resource.data.guestUid == request.auth.uid &&
          request.resource.data.guestActionId is int &&
          request.resource.data.guestActionId == resource.data.guestActionId + 1 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestAction', 'guestActionId']);
      }

      // A signed-in user may read a waiting room only when they already know
      // its unguessable document ID. This is required by the join flow's getDoc.
      allow read: if isParticipant() || (signedIn() && isJoinableWaitingRoom());

      allow create: if signedIn() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.guestUid == null &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.hostName is string &&
        request.resource.data.hostName.size() > 0 &&
        request.resource.data.hostName.size() <= 10 &&
        request.resource.data.hostColor is int &&
        request.resource.data.keys().hasOnly([
          'hostUid', 'hostName', 'hostColor', 'mapId',
          'goalCurrency', 'playerCount', 'allianceMode', 'randomAlliance', 'cpuNames', 'participants', 'participantUids',
          'guestUid', 'guestName', 'guestColor', 'guestDeckList',
          'status', 'createdAt', 'publicState',
          'hostRequestId', 'hostRequest',
          'guestResponseId', 'guestResponse',
          'guestActionId', 'guestAction'
        ]);

      // ホストは全フィールド更新可。ゲストは「部屋への参加」または
      // 「guestResponse系フィールドのみの更新」だけが許される。
      allow update: if signedIn() && (
        (
          resource.data.hostUid == request.auth.uid &&
          request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.guestUid == resource.data.guestUid
        ) ||
        isValidJoin() || isValidRosterJoin() ||
        isValidGuestResponse() ||
        isValidGuestAction()
      );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /private/{uid} {
        function parentRoom() {
          return get(/databases/$(database)/documents/pvpRooms/$(roomCode));
        }

        function uidIsParticipant() {
          return parentRoom().data.hostUid == uid || parentRoom().data.guestUid == uid ||
            (parentRoom().data.participantUids is list && uid in parentRoom().data.participantUids);
        }

        allow read: if request.auth != null && request.auth.uid == uid && uidIsParticipant();
        allow write: if request.auth != null &&
          parentRoom().data.hostUid == request.auth.uid && uidIsParticipant() &&
          request.resource.data.keys().hasOnly(['hand']) &&
          request.resource.data.hand is list &&
          request.resource.data.hand.size() <= 7;
      }

      match /actions/{uid} {
        function parentRoom() {
          return get(/databases/$(database)/documents/pvpRooms/$(roomCode));
        }
        function isRoomParticipant() {
          return parentRoom().data.hostUid == uid ||
            (parentRoom().data.participantUids is list && uid in parentRoom().data.participantUids);
        }
        allow read: if signedIn() && parentRoom().data.hostUid == request.auth.uid && isRoomParticipant();
        allow create, update: if signedIn() && request.auth.uid == uid && isRoomParticipant() &&
          request.resource.data.keys().hasOnly(['actionId', 'action', 'uid', 'lastSeen']) &&
          request.resource.data.uid == uid && request.resource.data.actionId is int &&
          request.resource.data.action is map;
      }
      match /prompts/{uid} {
        function parentRoom() { return get(/databases/$(database)/documents/pvpRooms/$(roomCode)); }
        function participant() { return parentRoom().data.hostUid == uid || (parentRoom().data.participantUids is list && uid in parentRoom().data.participantUids); }
        allow read: if signedIn() && request.auth.uid == uid && participant();
        allow write: if signedIn() && parentRoom().data.hostUid == request.auth.uid && participant() && request.resource.data.keys().hasOnly(['requestId','type','payload']);
      }
      match /promptResponses/{uid} {
        function parentRoom() { return get(/databases/$(database)/documents/pvpRooms/$(roomCode)); }
        function participant() { return parentRoom().data.hostUid == uid || (parentRoom().data.participantUids is list && uid in parentRoom().data.participantUids); }
        allow read: if signedIn() && parentRoom().data.hostUid == request.auth.uid && participant();
        allow write: if signedIn() && request.auth.uid == uid && participant() && request.resource.data.keys().hasOnly(['requestId','value']);
      }
    }
  }
}
