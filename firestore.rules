rules_version = '2';

// 対人戦（PvP）専用のセキュリティルール。ホスト権威モデル:
// - ホスト（部屋を作った側）のブラウザだけが本物のGameシミュレーションを
//   持ち、盤面・通行料・ダイス等すべてを計算する「権威」。
// - ゲストは自分の手番の意思決定（hostRequestで来る質問への回答）だけを
//   guestResponse系フィールドに書き込める。盤面やGなど他のフィールドは
//   一切書き換えられない。
// - 各プレイヤーの手札（private/{uid}.hand）はそのuid本人しか読めない。
service cloud.firestore {
  match /databases/{database}/documents {
    // ログイン済み本人だけが自分のセーブデータを読書きできる。
    // M・ガチャ結果の正当性検証はFunctions導入後にサーバー側で行う。
    match /players/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /pvpRooms/{roomCode} {
      function signedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return signedIn() &&
          (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid);
      }

      function isWaitingRoom() {
        return resource.data.status == 'waiting' && resource.data.guestUid == null;
      }

      function isValidJoin() {
        return signedIn() &&
          isWaitingRoom() &&
          request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.status == 'active' &&
          request.resource.data.guestName is string &&
          request.resource.data.guestName.size() > 0 &&
          request.resource.data.guestName.size() <= 10 &&
          request.resource.data.guestColor is int &&
          request.resource.data.guestDeckList is list &&
          request.resource.data.guestDeckList.size() == 40 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestUid', 'guestName', 'guestColor', 'guestDeckList', 'status']);
      }

      function isValidGuestResponse() {
        return resource.data.guestUid == request.auth.uid &&
          request.resource.data.guestResponseId is int &&
          request.resource.data.guestResponseId == resource.data.hostRequestId &&
          request.resource.data.guestResponseId > resource.data.guestResponseId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestResponse', 'guestResponseId']);
      }

      function isValidGuestAction() {
        return resource.data.guestUid == request.auth.uid &&
          request.resource.data.guestActionId is int &&
          request.resource.data.guestActionId == resource.data.guestActionId + 1 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestAction', 'guestActionId']);
      }

      // A signed-in user may read a waiting room only when they already know
      // its unguessable document ID. This is required by the join flow's getDoc.
      allow read: if isParticipant() || (signedIn() && isWaitingRoom());

      allow create: if signedIn() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.guestUid == null &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.hostName is string &&
        request.resource.data.hostName.size() > 0 &&
        request.resource.data.hostName.size() <= 10 &&
        request.resource.data.hostColor is int &&
        request.resource.data.keys().hasOnly([
          'hostUid', 'hostName', 'hostColor', 'mapId',
          'guestUid', 'guestName', 'guestColor', 'guestDeckList',
          'status', 'createdAt', 'publicState',
          'hostRequestId', 'hostRequest',
          'guestResponseId', 'guestResponse',
          'guestActionId', 'guestAction'
        ]);

      // ホストは全フィールド更新可。ゲストは「部屋への参加」または
      // 「guestResponse系フィールドのみの更新」だけが許される。
      allow update: if signedIn() && (
        (
          resource.data.hostUid == request.auth.uid &&
          request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.guestUid == resource.data.guestUid
        ) ||
        isValidJoin() ||
        isValidGuestResponse() ||
        isValidGuestAction()
      );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /private/{uid} {
        function parentRoom() {
          return get(/databases/$(database)/documents/pvpRooms/$(roomCode));
        }

        function uidIsParticipant() {
          return parentRoom().data.hostUid == uid || parentRoom().data.guestUid == uid;
        }

        allow read: if request.auth != null && request.auth.uid == uid && uidIsParticipant();
        allow write: if request.auth != null &&
          parentRoom().data.hostUid == request.auth.uid && uidIsParticipant() &&
          request.resource.data.keys().hasOnly(['hand']) &&
          request.resource.data.hand is list &&
          request.resource.data.hand.size() <= 7;
      }
    }
  }
}
