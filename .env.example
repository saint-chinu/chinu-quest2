# Firebase Console → プロジェクトの設定 → 「マイアプリ」のSDK設定に出てくる
# firebaseConfig の値をここに転記し、このファイルを .env という名前でコピーする
# （.env は .gitignore 済みでコミットされない）。
# 対人戦（PvP）、Firebase Authentication、クラウドセーブに利用する。
# Authenticationで「メール/パスワード」を有効化すると、ゲーム画面のID＋
# パスワードログインが使える（IDは内部で専用メールアドレスへ変換される）。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console → App Check → Web app → reCAPTCHA Enterprise provider
# 本番ではこの値を設定してから、FirestoreのApp Check enforcementを有効化する。
VITE_FIREBASE_APPCHECK_SITE_KEY=
